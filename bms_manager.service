[Unit]
Description=Start BMS Manager ROS Node
After=aruco.service
Wants=aruco.service

[Service]
User=ubuntu
Group=dialout
WorkingDirectory=/home/ubuntu
ExecStart=/bin/bash -c "source /opt/ros/noetic/setup.bash && source /home/ubuntu/catkin_ws/devel/setup.bash && systemctl restart roscore && systemctl restart aruco && rosrun bms_manager bms_manager_node"
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
PrivateDevices=no
ProtectSystem=full
ProtectHome=no

[Install]
WantedBy=multi-user.target
